{
  "compilerOptions": {
    // Node ejecuta los .ts directamente (borra los tipos), asi que TypeScript
    // solo lo usamos para revisar errores de tipos, no para generar .js
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    // Solo permite sintaxis de TS que Node puede "borrar" sin transformar el codigo
    "erasableSyntaxOnly": true,
    // permite importar con la extension .ts (ej4 importa las clases de ej3.ts)
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
